<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="MicrosoftPackageFeed" value="https://packagefeedproxy.microsoft.io/nuget/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="MicrosoftPackageFeed">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>